### 9. Body không phải JSON -> 400 (trước đây lỗi này bị báo nhầm thành 500)
POST {{host}}/api/still-us
Content-Type: application/json

{ "orderCode": "DD261017-F5G6H",

> {%
    client.test("JSON hỏng", function () {
        client.assert(response.status === 400, "Mã trạng thái: " + response.status);
        client.assert(response.body.message === "Dữ liệu gửi lên không đúng định dạng JSON", "Thông báo: " + response.body.message);
    });
%}

### 10. Xem chuỗi khi quét QR -> 200, không lộ SĐT
GET {{host}}/api/still-us/anbinh2026

> {%
    client.test("Xem chuỗi", function () {
        client.assert(response.status === 200, "Mã trạng thái: " + response.status);
        client.assert(response.body.registered === true, "registered: " + response.body.registered);
        client.assert(response.body.ownerName === "An" && response.body.partnerName === "Bình", "Tên chưa đúng");
        client.assert(response.body.status === "ACTIVE", "Trạng thái: " + response.body.status);
        client.assert(response.body.daysLeft === 365, "Số ngày còn lại: " + response.body.daysLeft);
        client.assert(response.body.yearNumber === 1, "Chuỗi thứ: " + response.body.yearNumber);
        client.assert(response.body.milestones.length === 3, "Số mốc: " + response.body.milestones.length);
        client.assert(response.body.milestones[0].day === 90 && response.body.milestones[0].reached === false, "Mốc 90 ngày sai");
        client.assert(JSON.stringify(response.body).indexOf("0901234567") === -1, "Lộ SĐT!");
    });
%}

### 11. Mã QR in sẵn nhưng chưa đăng ký -> 200, registered = false, không có tên
GET {{host}}/api/still-us/anbinh2027

> {%
    client.test("Chưa đăng ký", function () {
        client.assert(response.status === 200, "Mã trạng thái: " + response.status);
        client.assert(response.body.registered === false, "registered: " + response.body.registered);
        client.assert(response.body.ownerName === null, "Không được có tên");
    });
%}

### 12. Mã không tồn tại -> 404
GET {{host}}/api/still-us/khongtontai

> {%
    client.test("Mã không tồn tại", function () {
        client.assert(response.status === 404, "Mã trạng thái: " + response.status);
        client.assert(response.body.message === "Không tìm thấy chuỗi STILL US", "Thông báo: " + response.body.message);
    });
%}

### 13. Huỷ với SĐT không khớp -> 403
POST {{host}}/api/still-us/anbinh2026/cancel
Content-Type: application/json

{
  "phone": "0912345678",
  "reason": "Thử huỷ hộ"
}

> {%
    client.test("Huỷ sai SĐT", function () {
        client.assert(response.status === 403, "Mã trạng thái: " + response.status);
        client.assert(response.body.message === "Số điện thoại không khớp với chuỗi STILL US này", "Thông báo: " + response.body.message);
    });
%}

### 14. Huỷ đúng (SĐT dạng +84) -> 200, voucher còn dùng được bị thu hồi
POST {{host}}/api/still-us/anbinh2026/cancel
Content-Type: application/json

{
  "phone": "+84 901 234 567",
  "reason": "Chia tay"
}

> {%
    client.test("Huỷ đúng", function () {
        client.assert(response.status === 200, "Mã trạng thái: " + response.status);
        client.assert(response.body.status === "CANCELLED", "Trạng thái: " + response.body.status);
        client.assert(response.body.revokedVouchers === 1, "Số voucher thu hồi: " + response.body.revokedVouchers);
    });
%}

### 15. Huỷ lần 2 -> 409
POST {{host}}/api/still-us/anbinh2026/cancel
Content-Type: application/json

{
  "phone": "0901234567"
}

> {%
    client.test("Huỷ lần 2", function () {
        client.assert(response.status === 409, "Mã trạng thái: " + response.status);
        client.assert(response.body.message === "Chuỗi STILL US này đã huỷ trước đó", "Thông báo: " + response.body.message);
    });
%}

### 16. Xem lại sau khi huỷ -> CANCELLED, còn 0 ngày
GET {{host}}/api/still-us/anbinh2026

> {%
    client.test("Xem sau khi huỷ", function () {
        client.assert(response.status === 200, "Mã trạng thái: " + response.status);
        client.assert(response.body.status === "CANCELLED", "Trạng thái: " + response.body.status);
        client.assert(response.body.daysLeft === 0, "Số ngày còn lại: " + response.body.daysLeft);
        client.assert(response.body.cancelledAt !== null, "Thiếu ngày huỷ");
    });
%}

### 17. Huỷ chuỗi chưa đăng ký -> 404
POST {{host}}/api/still-us/anbinh2027/cancel
Content-Type: application/json

{
  "phone": "0901234567"
}

> {%
    client.test("Huỷ chuỗi chưa đăng ký", function () {
        client.assert(response.status === 404, "Mã trạng thái: " + response.status);
    });
%}
