# Test các API Quản lý Sản phẩm & Biến thể: /api/admin/products
# Cách chạy: Mở file này trong IntelliJ IDEA, chạy app Spring Boot trước,
# rồi bấm biểu tượng ▶▶ (Run All Requests) ở đầu file.
# Tiêu chuẩn nghiệm thu theo tài liệu (vieccualong.pdf):
#   1. Danh sách sản phẩm Admin: phân trang, lọc theo tên/code/slug, lọc trạng thái, lọc danh mục
#   2. Chi tiết sản phẩm: trả về đầy đủ thông tin kèm danh sách biến thể
#   3. Thêm/sửa sản phẩm: kiểm tra trùng code (409), trùng slug (409), giá âm (400)
#   4. Thêm/sửa/xoá biến thể: kiểm tra trùng SKU (409), tồn kho âm (400), tính đúng finalPrice
#   5. Đổi trạng thái DRAFT -> ACTIVE -> HIDDEN
#   6. Xoá mềm sản phẩm (is_deleted = true, trả 204)
#   7. Kiểm tra tương thích: Không làm thay đổi hay ảnh hưởng đến API khách hàng (GET /api/products)

@host = http://localhost:8080

### 1. Đăng nhập Admin lấy token
POST {{host}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123456"
}

> {%
    client.test("Admin đăng nhập thành công", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.global.set("adminToken", response.body.token);
    });
%}

### 2. Admin lấy danh sách sản phẩm (thấy cả DRAFT, ACTIVE)
GET {{host}}/api/admin/products?page=0&size=10
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin xem danh sách sản phẩm", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.totalItems >= 4, "totalItems: " + response.body.totalItems);
        var hasDraft = response.body.items.some(function(p) { return p.status === "DRAFT"; });
        client.assert(hasDraft, "Danh sách admin phải thấy được sản phẩm DRAFT");
    });
%}

### 3. Admin tìm kiếm sản phẩm theo từ khóa "Classic"
GET {{host}}/api/admin/products?search=Classic
Authorization: Bearer {{adminToken}}

> {%
    client.test("Tìm kiếm sản phẩm thành công", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.totalItems >= 1, "Phải tìm thấy sản phẩm chứa 'Classic'");
    });
%}

### 4. Admin lọc sản phẩm theo trạng thái DRAFT
GET {{host}}/api/admin/products?status=DRAFT
Authorization: Bearer {{adminToken}}

> {%
    client.test("Lọc sản phẩm theo trạng thái DRAFT", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        var allDraft = response.body.items.every(function(p) { return p.status === "DRAFT"; });
        client.assert(allDraft, "Tất cả sản phẩm trả về phải là DRAFT");
    });
%}

### 5. Admin xem chi tiết sản phẩm ID 1
GET {{host}}/api/admin/products/1
Authorization: Bearer {{adminToken}}

> {%
    client.test("Xem chi tiết sản phẩm ID 1", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.id === 1, "ID không khớp: " + response.body.id);
        client.assert(response.body.code === "CLS-DEMO-01", "Sai code: " + response.body.code);
        client.assert(response.body.variants.length >= 1, "Phải có danh sách biến thể");
    });
%}

### 6. Admin tạo sản phẩm mới ở trạng thái DRAFT -> 201 Created
POST {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Dép Clog Test Admin",
  "slug": "dep-clog-test-admin",
  "code": "TST-CLOG-01",
  "categoryId": 1,
  "shortDescription": "Sản phẩm thử nghiệm chức năng admin",
  "description": "Mô tả chi tiết sản phẩm thử nghiệm",
  "basePrice": 350000,
  "mockupImageUrl": "https://example.com/mockup-test.png",
  "isCustomizable": true,
  "isCoupleBox": false,
  "weightGrams": 400,
  "status": "DRAFT"
}

> {%
    client.test("Tạo sản phẩm mới thành công", function () {
        client.assert(response.status === 201, "Status: " + response.status);
        client.assert(response.body.code === "TST-CLOG-01", "Code: " + response.body.code);
        client.assert(response.body.status === "DRAFT", "Status: " + response.body.status);
        client.assert(response.body.basePrice === 350000, "BasePrice: " + response.body.basePrice);
        client.global.set("newProductId", response.body.id);
    });
%}

### 7. Tạo sản phẩm trùng mã (code) -> 409 Conflict
POST {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Sản phẩm trùng code",
  "slug": "san-pham-trung-code-khac",
  "code": "TST-CLOG-01",
  "categoryId": 1,
  "basePrice": 200000
}

> {%
    client.test("Trùng code trả 409", function () {
        client.assert(response.status === 409, "Status: " + response.status);
    });
%}

### 8. Tạo sản phẩm trùng slug -> 409 Conflict
POST {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Sản phẩm trùng slug",
  "slug": "dep-clog-test-admin",
  "code": "TST-CLOG-KHAC",
  "categoryId": 1,
  "basePrice": 200000
}

> {%
    client.test("Trùng slug trả 409", function () {
        client.assert(response.status === 409, "Status: " + response.status);
    });
%}

### 9. Tạo sản phẩm với giá cơ bản âm -> 400 Bad Request
POST {{host}}/api/admin/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Sản phẩm giá âm",
  "slug": "san-pham-gia-am",
  "code": "TST-CLOG-NEG",
  "categoryId": 1,
  "basePrice": -50000
}

> {%
    client.test("Giá âm trả 400", function () {
        client.assert(response.status === 400, "Status: " + response.status);
    });
%}

### 10. Cập nhật thông tin sản phẩm vừa tạo -> 200 OK
PUT {{host}}/api/admin/products/{{newProductId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Dép Clog Test Admin (Đã Sửa)",
  "slug": "dep-clog-test-admin",
  "code": "TST-CLOG-01",
  "categoryId": 1,
  "shortDescription": "Sản phẩm thử nghiệm đã cập nhật mô tả",
  "description": "Mô tả chi tiết cập nhật",
  "basePrice": 350000,
  "mockupImageUrl": "https://example.com/mockup-updated.png",
  "isCustomizable": true,
  "isCoupleBox": false,
  "weightGrams": 450,
  "status": "DRAFT"
}

> {%
    client.test("Cập nhật sản phẩm thành công", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.name === "Dép Clog Test Admin (Đã Sửa)", "Tên không khớp");
        client.assert(response.body.weightGrams === 450, "Cân nặng không khớp");
    });
%}

### 11. Thêm biến thể cho sản phẩm vừa tạo -> 201 Created
POST {{host}}/api/admin/products/{{newProductId}}/variants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TST-CLOG-DEN-38",
  "priceAdjustment": 20000,
  "stockQuantity": 50,
  "imageUrl": "https://example.com/variant-black-38.png",
  "isActive": true,
  "attributeValueIds": [1, 3]
}

> {%
    client.test("Thêm biến thể thành công", function () {
        client.assert(response.status === 201, "Status: " + response.status);
        client.assert(response.body.sku === "TST-CLOG-DEN-38", "SKU: " + response.body.sku);
        client.assert(response.body.stockQuantity === 50, "Stock: " + response.body.stockQuantity);
        client.assert(response.body.finalPrice === 370000, "FinalPrice: " + response.body.finalPrice);
        client.assert(response.body.attributeValues.length === 2, "Thuộc tính: " + response.body.attributeValues.length);
        client.global.set("newVariantId", response.body.id);
    });
%}

### 12. Thêm biến thể trùng mã SKU -> 409 Conflict
POST {{host}}/api/admin/products/{{newProductId}}/variants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TST-CLOG-DEN-38",
  "priceAdjustment": 0,
  "stockQuantity": 10,
  "isActive": true
}

> {%
    client.test("Trùng SKU trả 409", function () {
        client.assert(response.status === 409, "Status: " + response.status);
    });
%}

### 13. Thêm biến thể với tồn kho âm -> 400 Bad Request
POST {{host}}/api/admin/products/{{newProductId}}/variants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TST-CLOG-AM-KHO",
  "priceAdjustment": 0,
  "stockQuantity": -10,
  "isActive": true
}

> {%
    client.test("Tồn kho âm trả 400", function () {
        client.assert(response.status === 400, "Status: " + response.status);
    });
%}

### 14. Cập nhật biến thể vừa tạo -> 200 OK
PUT {{host}}/api/admin/products/variants/{{newVariantId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "TST-CLOG-DEN-38-V2",
  "priceAdjustment": 30000,
  "stockQuantity": 80,
  "imageUrl": "https://example.com/variant-black-38-v2.png",
  "isActive": true,
  "attributeValueIds": [1, 3]
}

> {%
    client.test("Cập nhật biến thể thành công", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.sku === "TST-CLOG-DEN-38-V2", "SKU không khớp");
        client.assert(response.body.stockQuantity === 80, "Stock không khớp");
        client.assert(response.body.finalPrice === 380000, "FinalPrice: " + response.body.finalPrice);
    });
%}

### 15. Đổi trạng thái sản phẩm sang ACTIVE -> 200 OK
PATCH {{host}}/api/admin/products/{{newProductId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "ACTIVE"
}

> {%
    client.test("Đổi trạng thái sang ACTIVE", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.status === "ACTIVE", "Status: " + response.body.status);
    });
%}

### 16. Đổi trạng thái sản phẩm sang HIDDEN -> 200 OK
PATCH {{host}}/api/admin/products/{{newProductId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "HIDDEN"
}

> {%
    client.test("Đổi trạng thái sang HIDDEN", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.status === "HIDDEN", "Status: " + response.body.status);
    });
%}

### 17. Xoá biến thể vừa tạo -> 204 No Content
DELETE {{host}}/api/admin/products/variants/{{newVariantId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Xoá biến thể thành công", function () {
        client.assert(response.status === 204, "Status: " + response.status);
    });
%}

### 18. Xoá mềm sản phẩm -> 204 No Content
DELETE {{host}}/api/admin/products/{{newProductId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Xoá mềm sản phẩm thành công", function () {
        client.assert(response.status === 204, "Status: " + response.status);
    });
%}

### 19. Kiểm tra sản phẩm đã bị xoá mềm không còn truy cập được -> 404 Not Found
GET {{host}}/api/admin/products/{{newProductId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Sản phẩm đã xoá mềm trả 404", function () {
        client.assert(response.status === 404, "Status: " + response.status);
    });
%}

### 20. KIỂM TRA HỒI QUY: API khách hàng vẫn có đúng 3 sản phẩm ban đầu
GET {{host}}/api/products

> {%
    client.test("Trang khách hàng không bị ảnh hưởng, vẫn 3 sản phẩm", function () {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.totalItems === 3, "totalItems: " + response.body.totalItems);
    });
%}
